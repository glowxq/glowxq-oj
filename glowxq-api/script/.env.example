# ============================================================
# GlowXQ OJ - 环境变量配置
# 复制此文件为 .env 并根据需要修改
# ============================================================

# ==================== MySQL 配置 ====================
MYSQL_ROOT_PASSWORD=glowxq123456
MYSQL_DATABASE=glowxq_oj
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_PASSWORD=glowxq123456
REDIS_PORT=6379
REDIS_DATABASE=1

# ==================== MinIO 配置 ====================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexus-oj
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== JWT 配置 ====================
# 重要：请修改为随机字符串！deploy.sh 会自动生成
JWT_SECRET_KEY=your_secret_key_please_change_me

# ==================== 应用配置 ====================
APP_PORT=7101
SANDBOX_PORT=5050
JAVA_OPTS=-Xms256m -Xmx512m

# ==================== 数据目录 ====================
DATA_DIR=./data

