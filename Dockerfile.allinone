# ============================================================
# GlowXQ OJ - All-in-One 单容器多阶段构建
#
# 包含全部 6 个服务：Nginx + MySQL + Redis + MinIO + go-judge + Spring Boot
# 数据持久化通过 Docker Volume 挂载 /data 目录
#
# 构建: docker build -f Dockerfile.allinone -t glowxq-oj:allinone .
# ============================================================

# ==================== Stage 1: Maven 编译后端 ====================
FROM maven:3.9-eclipse-temurin-21 AS maven-builder

WORKDIR /build

# 配置 Maven 阿里云镜像（国内服务器构建加速，解决 dependency:go-offline 卡住问题）
RUN mkdir -p /root/.m2 && cat > /root/.m2/settings.xml << 'EOF'
<settings>
  <mirrors>
    <mirror>
      <id>aliyun</id>
      <mirrorOf>central</mirrorOf>
      <name>Aliyun Maven Central Mirror</name>
      <url>https://maven.aliyun.com/repository/central</url>
    </mirror>
    <mirror>
      <id>aliyun-public</id>
      <mirrorOf>*</mirrorOf>
      <name>Aliyun Public Maven Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
    </mirror>
  </mirrors>
</settings>
EOF

# 先复制所有 pom.xml，利用 Docker 层缓存加速依赖下载
COPY glowxq-api/pom.xml .
COPY glowxq-api/build/pom.xml build/pom.xml

COPY glowxq-api/dependencies/pom.xml dependencies/pom.xml

COPY glowxq-api/common/pom.xml common/pom.xml
COPY glowxq-api/common/common-core/pom.xml common/common-core/pom.xml
COPY glowxq-api/common/common-business/pom.xml common/common-business/pom.xml
COPY glowxq-api/common/common-db-mysql/pom.xml common/common-db-mysql/pom.xml
COPY glowxq-api/common/common-db-redis/pom.xml common/common-db-redis/pom.xml
COPY glowxq-api/common/common-db-mongodb/pom.xml common/common-db-mongodb/pom.xml
COPY glowxq-api/common/common-excel/pom.xml common/common-excel/pom.xml
COPY glowxq-api/common/common-generator/pom.xml common/common-generator/pom.xml
COPY glowxq-api/common/common-log/pom.xml common/common-log/pom.xml
COPY glowxq-api/common/common-mq/pom.xml common/common-mq/pom.xml
COPY glowxq-api/common/common-oss/pom.xml common/common-oss/pom.xml
COPY glowxq-api/common/common-security/pom.xml common/common-security/pom.xml
COPY glowxq-api/common/common-tenant/pom.xml common/common-tenant/pom.xml
COPY glowxq-api/common/common-websocket/pom.xml common/common-websocket/pom.xml
COPY glowxq-api/common/common-wechat/pom.xml common/common-wechat/pom.xml

COPY glowxq-api/business/pom.xml business/pom.xml
COPY glowxq-api/business/business-oj/pom.xml business/business-oj/pom.xml
COPY glowxq-api/business/business-system/pom.xml business/business-system/pom.xml

COPY glowxq-api/app/pom.xml app/pom.xml
COPY glowxq-api/app/app-oj/pom.xml app/app-oj/pom.xml

# 下载依赖（利用缓存）
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:go-offline -DskipTests -q 2>/dev/null || true

# 复制全部源码并编译
COPY glowxq-api/ .

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn clean package -DskipTests -q

# ==================== Stage 2: 前端构建 ====================
FROM node:20-alpine AS web-builder

WORKDIR /app

# 安装 pnpm + 配置国内镜像
RUN npm install -g pnpm && \
    npm config set registry https://registry.npmmirror.com && \
    pnpm config set registry https://registry.npmmirror.com

# 先复制依赖文件，利用缓存
COPY oj-web/package.json oj-web/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

# 复制源码并构建
COPY oj-web/ .

# Docker 部署时 API 走 Nginx 反代，使用相对路径
ENV VITE_API_URL=/api
# WebSocket URL 留空，前端自动根据 window.location 推导
# ENV VITE_SOCKET_URL=

# 构建版本号（由部署脚本传入，用于页面展示判断是否更新成功）
ARG APP_BUILD_VERSION=dev
ENV VITE_APP_BUILD_VERSION=${APP_BUILD_VERSION}

RUN pnpm build-only --mode oj

# ==================== Stage 3: 从官方镜像提取 MinIO 二进制 ====================
# 避免 wget 从 dl.min.io 下载（国内网络极慢），直接从 Docker 镜像复制
FROM minio/minio:latest AS minio-bin
FROM minio/mc:latest AS mc-bin

# ==================== Stage 4: 运行时 ====================
FROM eclipse-temurin:21-jdk-jammy

ARG DEBIAN_FRONTEND=noninteractive

ENV TZ=Asia/Shanghai

# 安装所有运行时依赖（含 MySQL + Redis）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3 \
    nginx \
    supervisor \
    curl \
    mysql-server \
    redis-server \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# 设置时区
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# ─── 从官方镜像复制 MinIO Server + Client ───
COPY --from=minio-bin /usr/bin/minio /usr/local/bin/minio
COPY --from=mc-bin /usr/bin/mc /usr/local/bin/mc

# ─── 创建目录结构 ───
# judge 沙盒目录
RUN mkdir -p /judge/testcase /judge/run /judge/spj /judge/log /judge/server

# 应用数据目录
RUN mkdir -p /goj/testcase \
    /goj/file/avatar/group \
    /goj/file/carousel \
    /goj/file/md \
    /goj/file/problem/upload/tmp \
    /goj/file/zip/download \
    /goj/file/zip/contest_ac \
    /goj/file/contest_print

# 持久化数据目录（挂载到 Docker Volume）
RUN mkdir -p /data/minio /data/mysql /data/redis

# MySQL socket 目录
RUN mkdir -p /var/run/mysqld && chown mysql:mysql /var/run/mysqld

# Nginx 日志目录
RUN mkdir -p /var/log/nginx

# ─── 从 maven-builder 复制后端产物 ───
COPY --from=maven-builder /build/app/app-oj/target/*.jar /judge/server/app.jar
COPY glowxq-api/app/app-oj/run.sh /judge/server/run.sh
COPY glowxq-api/app/app-oj/testlib.h /usr/include/testlib.h
COPY glowxq-api/app/app-oj/Sandbox-amd64 /judge/server/Sandbox-amd64
COPY glowxq-api/app/app-oj/Sandbox-arm64 /judge/server/Sandbox-arm64
RUN chmod +x /judge/server/run.sh /judge/server/Sandbox-amd64 /judge/server/Sandbox-arm64

# ─── 从 web-builder 复制前端产物 ───
COPY --from=web-builder /app/dist /usr/share/nginx/html

# ─── 复制数据库初始化脚本 ───
COPY glowxq-api/script/init.sql /docker-entrypoint-initdb.d/init.sql

# ─── 复制配置文件 ───
COPY nginx.allinone.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# 删除 Nginx 默认站点配置（避免冲突）
RUN rm -f /etc/nginx/sites-enabled/default

# 设置默认环境变量
ENV SPRING_PROFILES_ACTIVE=prod
# MySQL / Redis 全部容器内部运行，使用 127.0.0.1
ENV MYSQL_HOST=127.0.0.1
ENV MYSQL_PORT=3306
ENV MYSQL_DATABASE=glowxq_oj
ENV MYSQL_USER=root
ENV MYSQL_ROOT_PASSWORD=glowxq123456
ENV REDIS_HOST=127.0.0.1
ENV REDIS_PORT=6379
ENV REDIS_PASSWORD=glowxq123456
ENV REDIS_DATABASE=1
ENV OSS_ENDPOINT=http://127.0.0.1:9000
# OSS_DOMAIN 留空：由 entrypoint 根据 SITE_URL 自动推导
ENV OSS_DOMAIN=
ENV SITE_URL=
ENV OSS_ACCESS_KEY=minioadmin
ENV OSS_SECRET_KEY=minioadmin
ENV JWT_SECRET_KEY=please_change_me
ENV JAVA_OPTS="-Xms256m -Xmx512m"

WORKDIR /judge/server

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
